# Neon PostgreSQL
DATABASE_URL=postgres://user:pass@ep-xxx.region.aws.neon.tech/airank?sslmode=require

# ─────────────────────────────────────────────
# Waffo 支付（V1.2 主推，美元 USD 收款）
# ─────────────────────────────────────────────
# 商户 ID（MER_ 开头，从 Waffo Dashboard → 开发者 → 商户信息获取）
WAFFO_MERCHANT_ID=
# RSA 私钥（PEM 格式，含 -----BEGIN PRIVATE KEY----- 与 -----END PRIVATE KEY-----）
WAFFO_PRIVATE_KEY=
# 产品 ID：在 Waffo Dashboard 创建产品后得到的 prod_xxx
WAFFO_PRODUCT_ID=
# 可选：API 基础 URL，默认 https://api.waffo.ai
WAFFO_BASE_URL=
# 可选：站点公开 URL（支付成功跳转），例 https://toolsrank.ai
NEXT_PUBLIC_APP_URL=

# ─────────────────────────────────────────────
# YunGouOS 已弃用（V1.2 起国内 YunGouOS/微信/支付宝通道下线，代码保留兼容）
# ─────────────────────────────────────────────
# 仅保留兼容旧 webhook 验签，不再调用下单
YUNGOUOS_MCH_ID=
YUNGOUOS_PAY_KEY=
YUNGOUOS_NOTIFY_URL=https://yourdomain.com/api/v1/webhooks/yungouos
# 可选：默认 https://api.pay.yungouos.com
YUNGOUOS_API_BASE=

# Vercel Cron 保护
CRON_SECRET=change-me

# 点击 IP 哈希盐
CLICK_SALT=change-me

# 上架审核口令（/admin 面板；不设置则面板无法登录，榜单只显示审核通过的条目）
ADMIN_TOKEN=change-me-long-random

# 上架审核邮件通知（Resend，可选）
# 配置后，新条目进入 pending 时会给 ADMIN_NOTIFY_EMAIL 发邮件
RESEND_API_KEY=
ADMIN_NOTIFY_EMAIL=
# 可选：自定义发件人（需在 Resend 验证域名），默认 onboarding@resend.dev
NOTIFY_FROM=
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
NEXT_PUBLIC_CLARITY_ID=
